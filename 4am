<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>اختبار مراجعة التاريخ والجغرافيا - بكالوريا 2026</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(145deg, #f0f2f5 0%, #e6e9f0 100%);
            font-family: 'Cairo', 'Tahoma', 'Segoe UI', sans-serif;
            padding: 30px 20px;
            color: #1e2a3a;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        /* header */
        .hero {
            text-align: center;
            margin-bottom: 40px;
        }

        .hero h1 {
            font-size: 2.2rem;
            background: #1e3c2c;
            background: linear-gradient(135deg, #1e3c2c, #2a5a3a);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            text-shadow: 2px 2px 8px rgba(0,0,0,0.05);
            margin-bottom: 8px;
        }

        .hero p {
            color: #2c3e2f;
            font-weight: 500;
            background: #fff9e8;
            display: inline-block;
            padding: 8px 24px;
            border-radius: 40px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.05);
            font-size: 1rem;
        }

        /* cards for each part */
        .quiz-section {
            background: #ffffffdd;
            backdrop-filter: blur(2px);
            border-radius: 48px;
            margin-bottom: 45px;
            box-shadow: 0 20px 35px -12px rgba(0, 0, 0, 0.2);
            overflow: hidden;
            transition: transform 0.2s;
            border: 1px solid #ffffffaa;
        }

        .section-title {
            background: #1e3c2c;
            padding: 18px 28px;
            color: white;
            font-size: 1.7rem;
            font-weight: bold;
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
            justify-content: space-between;
        }

        .section-title h2 {
            font-size: 1.6rem;
            font-weight: 700;
            letter-spacing: -0.3px;
        }

        .score-badge {
            background: #f7b32b;
            color: #1e2a1e;
            padding: 8px 18px;
            border-radius: 60px;
            font-size: 1.2rem;
            font-weight: bold;
            box-shadow: inset 0 -1px 0 #ffdd99, 0 4px 10px rgba(0,0,0,0.1);
        }

        .questions-grid {
            padding: 25px 30px;
            display: flex;
            flex-direction: column;
            gap: 28px;
        }

        .question-card {
            background: white;
            border-radius: 32px;
            padding: 20px 25px;
            box-shadow: 0 8px 18px rgba(0, 0, 0, 0.05);
            transition: all 0.2s;
            border-right: 8px solid #f7b32b;
        }

        .q-text {
            font-size: 1.25rem;
            font-weight: 700;
            margin-bottom: 16px;
            display: flex;
            align-items: baseline;
            gap: 12px;
            flex-wrap: wrap;
        }

        .q-marks {
            background: #e9ecef;
            padding: 4px 12px;
            border-radius: 40px;
            font-size: 0.85rem;
            font-weight: normal;
            color: #2c5a2e;
        }

        .options {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin: 18px 0 15px;
            padding-right: 10px;
        }

        .option {
            display: flex;
            align-items: center;
            gap: 14px;
            cursor: pointer;
            background: #fef9ef;
            padding: 10px 18px;
            border-radius: 60px;
            transition: 0.1s;
            border: 1px solid #ffe3b5;
        }

        .option:hover {
            background: #fff0db;
            transform: translateX(-4px);
        }

        input[type="radio"] {
            width: 18px;
            height: 18px;
            accent-color: #2a7a3a;
            cursor: pointer;
        }

        .feedback {
            margin-top: 14px;
            padding: 12px 18px;
            border-radius: 28px;
            font-size: 0.95rem;
            font-weight: 500;
            background: #f1f3f5;
            display: none;
            align-items: center;
            gap: 12px;
            border-right: 5px solid #adb5bd;
        }

        .feedback.correct {
            background: #e0f2e9;
            border-right-color: #2b8c4a;
            color: #145c2e;
            display: flex;
        }

        .feedback.wrong {
            background: #ffe3e3;
            border-right-color: #c7362b;
            color: #a1221a;
            display: flex;
        }

        .btn-submit {
            background: #1e3c2c;
            border: none;
            color: white;
            font-size: 1.2rem;
            font-weight: bold;
            padding: 12px 28px;
            border-radius: 60px;
            cursor: pointer;
            transition: 0.2s;
            margin-top: 10px;
            width: fit-content;
            box-shadow: 0 5px 0 #0f2a1c;
        }

        .btn-submit:active {
            transform: translateY(2px);
            box-shadow: 0 2px 0 #0f2a1c;
        }

        .section-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 15px;
            padding: 0 30px 30px 30px;
            flex-wrap: wrap;
            gap: 20px;
        }

        .total-score {
            background: #2c3e2f;
            padding: 10px 25px;
            border-radius: 42px;
            color: #ffeaac;
            font-weight: bold;
            font-size: 1.2rem;
        }

        hr {
            margin: 20px 0;
            border: 1px dashed #ccd5ae;
        }

        footer {
            text-align: center;
            margin-top: 40px;
            color: #4a5b4e;
            font-weight: 500;
        }

        @media (max-width: 700px) {
            .questions-grid {
                padding: 15px;
            }
            .section-title h2 {
                font-size: 1.2rem;
            }
            .q-text {
                font-size: 1rem;
            }
        }
    </style>
</head>
<body>
<div class="container">
    <div class="hero">
        <h1>📚 مراجعة نهائية – مصطلحات وشخصيات</h1>
        <p>📖 التاريخ والجغرافيا | الأستاذة هجرسي نصيرة | الثالثة ثانوي (جميع الشعب)</p>
        <p style="font-size:0.9rem; margin-top:8px;">✨ اختبار تفاعلي من 30 نقطة (الوحدة الأولى + الثانية) مع التصحيح الآلي ✨</p>
    </div>

    <!-- ======================== PART 1 : الوحدة الأولى (شخصيات الحرب الباردة) ================= -->
    <div class="quiz-section" id="section1">
        <div class="section-title">
            <h2>🌍 الجزء الأول: شخصيات الوحدة الأولى – الحرب الباردة & أمريكا/الاتحاد السوفياتي</h2>
            <div class="score-badge" id="score1Label">🗳️ لم يتم التقييم بعد</div>
        </div>
        <div class="questions-grid" id="quiz1Container"></div>
        <div class="section-footer">
            <button class="btn-submit" id="submitBtn1">📝 تصحيح الجزء الأول (من 15)</button>
            <div class="total-score" id="total1Display">النتيجة: -- / 15</div>
        </div>
    </div>

    <!-- ======================== PART 2 : الوحدة الثانية (شخصيات الجزائر وفرنسا) ================= -->
    <div class="quiz-section" id="section2">
        <div class="section-title">
            <h2>⭐ الجزء الثاني: شخصيات الوحدة الثانية – الحركة الوطنية الجزائرية & الثورة & شخصيات فرنسية</h2>
            <div class="score-badge" id="score2Label">🗳️ لم يتم التقييم بعد</div>
        </div>
        <div class="questions-grid" id="quiz2Container"></div>
        <div class="section-footer">
            <button class="btn-submit" id="submitBtn2">📝 تصحيح الجزء الثاني (من 15)</button>
            <div class="total-score" id="total2Display">النتيجة: -- / 15</div>
        </div>
    </div>

    <footer>
        🌟 مراجعة سريعة قبل الامتحان – كل سؤال بـ 3 درجات | التغذية الراجعة توضح الإجابة الصحيحة 📖
    </footer>
</div>

<script>
    // -------------------- أسئلة الوحدة الأولى (5 أسئلة * 3 درجات = 15) --------------------
    const questionsPart1 = [
        {
            text: "⭕ من هو الرئيس الأمريكي الذي أعلن سياسة 'الاحتواء' ومهد للحرب الباردة، وكان مؤيداً للهجرة اليهودية؟",
            options: ["جون كينيدي", "هاري ترومان", "رونالد ريغان", "جورج مارشال"],
            correct: 1, // index 1 -> هاري ترومان
            explanation: "✅ الإجابة الصحيحة: هاري ترومان (1945-1953) أعلن سياسة الاحتواء ومهد لانطلاق الحرب الباردة."
        },
        {
            text: "⭕ من هو الزعيم السوفياتي الذي اتسم بالتشدد وحكم الفرد وأسس 'الكومنفورم' و'حلف وارسو'؟",
            options: ["نيكيتا خروتشوف", "أندري جدانوف", "جوزيف ستالين", "لينين"],
            correct: 2,
            explanation: "✅ جوزيف ستالين (1924-1953) قاد الاتحاد السوفياتي بصرامة، وأسس الكومنفورم وحلف وارسو لمواجهة الغرب."
        },
        {
            text: "⭕ صاحب نظرية 'الاشتراكية في بلد واحد' ومشروع 'مبدأ جدانوف' هو القيادي السوفياتي:",
            options: ["جورباتشوف", "أندري جدانوف", "خرشوف", "مولوتوف"],
            correct: 1,
            explanation: "✅ أندري جدانوف اشتهر بمبدأ جدانوف ونظرية الاشتراكية في بلد واحد، وكان متشدداً ضد التأثير الغربي."
        },
        {
            text: "⭕ الرئيس الأمريكي الذي اغتيل وحسن أوضاع السود وحارب التمييز العنصري في الستينات:",
            options: ["ليندون جونسون", "جون كينيدي", "ريتشارد نيكسون", "ترومان"],
            correct: 1,
            explanation: "✅ جون كينيدي (1961-1963) اغتيل، وقاد سياسات إصلاحية وأيد حركة الحقوق المدنية."
        },
        {
            text: "⭕ من هو أول زعيم سوفياتي زار الولايات المتحدة وطرح فكرة 'التعايش السلمي'؟",
            options: ["ستالين", "بريجنيف", "نيكيتا خروتشوف", "جدانوف"],
            correct: 2,
            explanation: "✅ نيكيتا خروتشوف دعا إلى التعايش السلمي وكان أول زعيم سوفياتي يزور أمريكا (1959)."
        }
    ];

    // -------------------- أسئلة الوحدة الثانية (شخصيات جزائرية وفرنسية) 5 أسئلة * 3 = 15 --------------------
    const questionsPart2 = [
        {
            text: "🇩🇿 عضو مجموعة الـ22 واللجنة الثورية، تولى رئاسة المجلس الشعبي الوطني بعد الاستقلال، من هو؟",
            options: ["محمد خيضر", "رابح بيطاط", "الشاذلي بن جديد", "فرحات عباس"],
            correct: 1,
            explanation: "✅ رابح بيطاط من مؤسسي الثورة، سجن وناضل، ترأس المجلس الشعبي الوطني بعد الاستقلال."
        },
        {
            text: "🇩🇿 شخصية جزائرية انخرطت في نجم شمال إفريقيا وحزب الشعب، وكان عنصراً بالمنظمة الخاصة (OS) واعتقل سنة 1950:",
            options: ["حسين آيت أحمد", "محمد خيضر", "العربي بن مهيدي", "مصالي الحاج"],
            correct: 1,
            explanation: "✅ محمد خيضر من رواد العمل الوطني، عضو المنظمة الخاصة، أطلق سراحه بعد الاستقلال."
        },
        {
            text: "🇫🇷 جنرال وسياسي فرنسي أسس الجمهورية الخامسة، جمع بين المكر والإغراء، ووقع اتفاقيات إيفيان 1962؟",
            options: ["ليون بلوم", "شارل ديغول", "جان سوستال", "فرنسوا ميتيران"],
            correct: 1,
            explanation: "✅ شارل ديغول قائد فرنسا الحرة، أسس الجمهورية الخامسة 1958، ووقع اتفاقيات إيفيان منهياً الحرب في الجزائر."
        },
        {
            text: "🇫🇷 صاحب مشروع الإدماج الشهير 'مشروع بلوم-فيوليت' سنة 1936 الذي كان يهدف إلى منح بعض الامتيازات للجزائريين:",
            options: ["جان سوستال", "ليون بلوم", "ديغول", "بيير منديس فرانس"],
            correct: 1,
            explanation: "✅ ليون بلوم (رئيس مجلس الوزراء الفرنسي) صاحب مشروع بلوم-فيوليت للإصلاحات المحدودة."
        },
        {
            text: "🇩🇿 قائد هجومات الشمال القسنطيني 20 أوت 1955، واستشهد سنة 1956، وكان عضواً بالمجلس الوطني للثورة:",
            options: ["ديدوش مراد", "زيغود يوسف", "علي كافي", "بن مهيدي"],
            correct: 1,
            explanation: "✅ زيغود يوسف قائد المنطقة الثانية، نظم هجومات أوت 1955، استشهد في معركة 1956."
        }
    ];

    // دالة عرض الأسئلة ديناميكياً
    function renderQuiz(containerId, questions, partIdPrefix) {
        const container = document.getElementById(containerId);
        if (!container) return;
        container.innerHTML = '';
        questions.forEach((q, idx) => {
            const qNumber = idx + 1;
            const card = document.createElement('div');
            card.className = 'question-card';
            card.setAttribute('data-q-idx', idx);
            card.setAttribute('data-part', partIdPrefix);
            
            // html
            card.innerHTML = `
                <div class="q-text">
                    <span>${qNumber}. ${q.text}</span>
                    <span class="q-marks">🔖 3 درجات</span>
                </div>
                <div class="options" id="options-${partIdPrefix}-${idx}">
                    ${q.options.map((opt, optIdx) => `
                        <label class="option">
                            <input type="radio" name="q${partIdPrefix}_${idx}" value="${optIdx}">
                            <span>${opt}</span>
                        </label>
                    `).join('')}
                </div>
                <div class="feedback" id="fb-${partIdPrefix}-${idx}"></div>
            `;
            container.appendChild(card);
        });
    }

    // دالة حساب النتيجة وعرض التعليقات لكل جزء
    function evaluatePart(questions, partPrefix, scoreDisplayId, totalSpanId, scoreLabelId) {
        let total = 0;
        let allAnswered = true;
        for (let i = 0; i < questions.length; i++) {
            const radios = document.getElementsByName(`q${partPrefix}_${i}`);
            let selectedVal = null;
            for (let r of radios) {
                if (r.checked) {
                    selectedVal = parseInt(r.value);
                    break;
                }
            }
            const feedbackDiv = document.getElementById(`fb-${partPrefix}-${i}`);
            if (selectedVal === undefined || selectedVal === null) {
                allAnswered = false;
                if (feedbackDiv) {
                    feedbackDiv.innerHTML = `⚠️ لم تُجب على هذا السؤال (الدرجة 0) الإجابة الصحيحة: ${questions[i].options[questions[i].correct]}`;
                    feedbackDiv.className = 'feedback wrong';
                }
                continue;
            }
            const isCorrect = (selectedVal === questions[i].correct);
            if (isCorrect) {
                total += 3;
                if (feedbackDiv) {
                    feedbackDiv.innerHTML = `✅ صحيح! +3 درجات. ${questions[i].explanation}`;
                    feedbackDiv.className = 'feedback correct';
                }
            } else {
                if (feedbackDiv) {
                    const correctAnswerText = questions[i].options[questions[i].correct];
                    feedbackDiv.innerHTML = `❌ خطأ. إجابتك: ${questions[i].options[selectedVal]} – الصحيح: ${correctAnswerText}. ${questions[i].explanation}`;
                    feedbackDiv.className = 'feedback wrong';
                }
            }
        }
        // تحديث عرض النتيجة
        const totalSpan = document.getElementById(totalSpanId);
        if (totalSpan) totalSpan.innerText = `النتيجة: ${total} / ${questions.length * 3}`;
        const scoreLabel = document.getElementById(scoreLabelId);
        if (scoreLabel) {
            const percent = (total / (questions.length * 3)) * 100;
            if (percent >= 70) scoreLabel.innerHTML = `🌟 النتيجة: ${total}/${questions.length*3} ممتاز!`;
            else if (percent >= 40) scoreLabel.innerHTML = `📘 النتيجة: ${total}/${questions.length*3} جيد، راجع الأخطاء`;
            else scoreLabel.innerHTML = `📖 النتيجة: ${total}/${questions.length*3} يحتاج مراجعة`;
        }
        return total;
    }
    
    // رندر الأجزاء عند تحميل الصفحة
    renderQuiz('quiz1Container', questionsPart1, 'p1');
    renderQuiz('quiz2Container', questionsPart2, 'p2');
    
    // ربط أزرار التصحيح
    const btn1 = document.getElementById('submitBtn1');
    const btn2 = document.getElementById('submitBtn2');
    
    if (btn1) {
        btn1.addEventListener('click', () => {
            evaluatePart(questionsPart1, 'p1', 'score1Label', 'total1Display', 'score1Label');
        });
    }
    if (btn2) {
        btn2.addEventListener('click', () => {
            evaluatePart(questionsPart2, 'p2', 'score2Label', 'total2Display', 'score2Label');
        });
    }
    
    // إضافة تنبيه سلس لتحسين تجربة المستخدم عند إعادة التصحيح (يُظهر كل الفيدباك بدون مشاكل)
    console.log("اختبار تفاعلي جاهز – من إعداد الأستاذة هجرسي نصيرة (مراجعة البكالوريا)");
</script>
</body>
</html>
